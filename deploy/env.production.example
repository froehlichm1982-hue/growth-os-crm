# Growth OS CRM production settings (NOT secret). Copy to crm.env.
# Secrets live in crm.secrets.env (600) and in the module secret file. Names only here.
# Values in <angle brackets> are filled in by OS Lead at deploy.

# --- app and domains -------------------------------------------------------
SERVER_URL=https://crm.scalepoint-ventures.com
FRONTEND_URL=https://crm.scalepoint-ventures.com
IS_MULTIWORKSPACE_ENABLED=true
DEFAULT_SUBDOMAIN=
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false
MAX_WORKSPACES=0
SIGN_IN_PREFILLED=false
IS_BILLING_ENABLED=false
STORAGE_TYPE=local
HELP_URL=https://scalepoint-ventures.com/growthos/crm/faq
SOURCE_CODE_URL=<public repository URL, AGPL section 13; set at GO>

# --- billing (shared growth-os-billing service) ----------------------------
BILLING_PROVIDER=growth-os
GROWTH_OS_BILLING_URL=https://billing.scalepoint-ventures.com
# The secret itself is the 600 file mounted by compose at this path (do not set MODULE_CRM_WEBHOOK_SECRET):
MODULE_CRM_WEBHOOK_SECRET_FILE=/run/secrets/module_crm_webhook_secret
GROWTH_OS_UNPAID_ACCESS=read_only

# --- privacy: nothing leaves for the upstream project, no tracking ----------
TELEMETRY_ENABLED=false
ANALYTICS_ENABLED=false
ALLOW_REQUESTS_TO_TWENTY_ICONS=false
EXCEPTION_HANDLER_DRIVER=console
SUPPORT_DRIVER=none
# Sentry stays unset: SENTRY_DSN, SENTRY_FRONT_DSN, SENTRY_ENVIRONMENT
# ClickHouse stays unset: CLICKHOUSE_URL
# AI keys stay unset: OPENAI_API_KEY, ANTHROPIC_API_KEY, GOOGLE_API_KEY, XAI_API_KEY, GROQ_API_KEY, MISTRAL_API_KEY, AI_PROVIDERS
# Enterprise stays unset: ENTERPRISE_KEY, ENTERPRISE_VALIDITY_TOKEN
# No OAuth buttons until real client ids exist:
AUTH_GOOGLE_ENABLED=false
AUTH_MICROSOFT_ENABLED=false

# --- accounts and mail ------------------------------------------------------
IS_EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=30m
EMAIL_DRIVER=smtp
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=resend
# EMAIL_SMTP_PASSWORD (the Resend key) is in crm.secrets.env. Leave RESEND_API_KEY unset: it would also switch on the Resend inbound path of the BCC inbox.
EMAIL_FROM_ADDRESS=noreply@scalepoint-ventures.com
EMAIL_FROM_NAME=ScalePoint Growth OS CRM
EMAIL_REPLY_TO=support@scalepoint-ventures.com
# The mail driver sends nothing unless this is exactly "true". It stays false until Markus' GO (deploy.sh --go-live).
SEND_EMAILS=false

# --- host-side compose settings --------------------------------------------
CRM_HTTP_PORT=3110
GROWTH_OS_CRM_IMAGE=growth-os-crm:rc1
MODULE_CRM_WEBHOOK_SECRET_HOST_FILE=<path of the 600 secret file on the host, owner uid 1000>
